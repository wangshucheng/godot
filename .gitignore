#############################
### Mono static libraries ###
#############################
# Mono 静态库（.a / .lib）是 WASM/Windows 构建的输入，必须入库以保证
# 构建可复现。这些库由 setup_mono_windows.ps1（Windows）或 WSL2 交叉
# 编译流程（WASM）生成；TOTAL_STACK 等根源修复会通过 ar r 替换 .a 中
# 的 .o，需要跟踪变更历史。
# 顺序很重要：先 re-include 目录（绕过 x64/ 目录忽略规则），再
# re-include .a/.lib 文件（绕过 *.a/*.lib 文件忽略规则）。
!mono/libs/
!mono/libs/**
!mono/libs/windows/
!mono/libs/windows/x64/
!mono/libs/windows/x64/**
!mono/libs/**/*.a
!mono/libs/**/*.lib

#############################
### Mono BCL + headers    ###
#############################
# Mono BCL（mono/lib/mono/4.5/*.dll，303 个 .dll，76 MB）是桌面端 Mono JIT
# 运行时依赖；mono/include/ 是编译期头文件；mono/etc/ 是运行时配置。
# 这些由 setup_mono_windows.ps1 从系统 Mono 6.12 提取，提取过程慢。
!mono/lib/
!mono/lib/**
!mono/lib/**/*.dll
!mono/include/
!mono/include/**
!mono/etc/
!mono/etc/**

#############################
### GodotSharp glue DLL   ###
#############################
# GodotSharp.dll 是 GodotSharp 胶水层编译产物（netstandard2.0，1.8 MB），
# 由 compile_godotsharp.py 从 modules/mono/glue/GodotSharp/*.cs 编译。
# 是所有 C# 项目（csharp_test/ProjectScripts.dll、AOT 编译）的引用依赖。
!build_godotsharp/
!build_godotsharp/**
!build_godotsharp/*.dll

#############################
### C# test assembly      ###
#############################
# ProjectScripts.dll 是 22 场景测试套件（Test.cs + Game2048.cs）的编译产物，
# 被 AOT 编译和 WASM 打包使用。源码在 csharp_test/*.cs，但 .dll 本身体积小
# (34 KB) 且重编需要 GodotSharp.dll，跟踪便于快速复现 WASM 测试。
!csharp_test/*.dll

#############################
### WASM AOT cache        ###
#############################
# mono/aot-cache/ 包含 WASM AOT 编译产物（56 MB）：mscorlib.o/System.o/
# System.Core.o/GodotSharp.o/ProjectScripts.o + 生成的 mono_aot_modules.gen.cpp
# + GenericRoots.gen.cs + .cache_hashes.json。AOT 编译耗时长（10+ 分钟），
# 且 mscorlib.o 含手动二进制补丁（修复 Mono 6.12 fill_number_data bug，
# 字节偏移 28744，sig=3→sig=6，详见架构文档 §10.3）。
!mono/aot-cache/
!mono/aot-cache/**
!mono/aot-cache/*.o
!mono/aot-cache/*.gen.cpp
!mono/aot-cache/*.gen.cs
!mono/aot-cache/.cache_hashes.json

#############################
### Tracked build outputs ###
#############################
# 跟踪耗时编译产物（WASM 重链 24 分钟 / Windows 构建 30-60 分钟 / AOT 编译
# 10+ 分钟 / GodotSharp 编译 / Mono BCL 提取），保证构建可复现。
#
# git 规则：父目录被 [Bb]in/ 排除则子目录无法 re-include，
# 必须先 !bin/ re-include 整个 bin/ 目录，再用单独的 ignore 规则
# 排除不需要跟踪的子目录（obj/.web_zip 等）。
!bin/

# 仍然忽略的 bin/ 子目录（中间产物）
bin/obj/

# Web WASM 模板（WASM 重链 24+ 分钟）
!bin/templates/web/
!bin/templates/web/**
!bin/templates/web/*.wasm
!bin/templates/web/*.js
!bin/templates/web/*.zip
# .web_zip/ 是 zip 解压副本，重复 154 MB，放在 negation 之后忽略（最后匹配胜出）
bin/templates/web/.web_zip/

# Windows 导出模板（构建约 30 分钟）
!bin/templates/windows/
!bin/templates/windows/**
!bin/templates/windows/*.exe
!bin/templates/windows/*.dll

# Windows 编辑器构建（构建约 60 分钟，开发时持续使用跑桌面回归测试）
!bin/editor/
!bin/editor/**
!bin/editor/windows/
!bin/editor/windows/**
!bin/editor/windows/*.exe
!bin/editor/windows/*.dll

# 链接器产物 + GodotProject 模板 + 编辑器运行时副产物
# （negation 之后再排除，最后匹配胜出）
bin/templates/**/*.exp
bin/templates/**/*.lib
bin/editor/**/*.exp
bin/editor/**/*.lib
bin/editor/**/GodotProject.*
# obj/、.mono/、GodotSharp/ 是编辑器运行时副产物（nuget 缓存、GodotSharp.dll 副本等）
bin/editor/**/obj/
bin/editor/**/.mono/
bin/editor/**/GodotSharp/

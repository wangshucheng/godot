def _get_bcl_wasm_dir():
    """Resolve BCL directory for WASM embedding (env var > project-local fallback)."""
    import os
    bcl_dir = os.environ.get("BCL_WASM_DIR", "")
    if bcl_dir and os.path.isdir(bcl_dir):
        return bcl_dir
    # Fallback: project-local mono BCL (prepared by setup_mono_windows.ps1)
    local_bcl = os.path.join(str(Dir("#").abspath), "mono", "lib", "mono", "4.5")
    if os.path.isdir(local_bcl):
        return local_bcl
    return bcl_dir  # Return whatever was set (may be empty/invalid)


# Godot Mono WASM 运行时必需的 BCL 程序集（白名单）。
# 这些是 netstandard2.0 + GodotSharp 的最小依赖集合，从第一性原理确定：
#   - mscorlib.dll: BCL 核心（Object/String/Type/Exception/_collections_）
#   - System.dll: BCL 扩展（Uri/TimeZone/IO/Net 等）
#   - System.Core.dll: LINQ / Expression Trees / DynamicMethod
#   - netstandard.dll: netstandard2.0 facade（GodotSharp.dll 与用户 .dll 的目标框架）
# 其他 BCL（System.Xml / System.Data / Microsoft.AspNetCore.* 等）Godot 不使用，
# 嵌入它们只会徒增 WASM 体积（每个 .dll 进入 MEMFS 数据段，且 emcc 不压缩）。
# 用户可通过 BCL_WASM_EXTRA_DLLS 环境变量追加（例如 System.Numerics.dll）。
_BCL_WASM_REQUIRED_DLLS = (
    "mscorlib.dll",
    "System.dll",
    "System.Core.dll",
    "netstandard.dll",
)


def _select_bcl_dlls(bcl_wasm_dir):
    """Select BCL DLLs to embed into WASM MEMFS.

    第一性原理：只嵌入 Godot Mono 运行时实际需要的 BCL，避免体积膨胀。

    策略：
      1. 白名单（_BCL_WASM_REQUIRED_DLLS）：默认必须嵌入的 4 个核心 BCL
      2. 环境变量 BCL_WASM_EXTRA_DLLS：用户可指定额外 DLL（逗号分隔，按需添加）
      3. 硬性排除：.so 原生库（已通过 mono 静态库链接进 WASM，重复嵌入浪费 18MB）

    Returns:
        List of (src_path, dst_path) tuples for emcc --embed-file.
    """
    import os
    selected = list(_BCL_WASM_REQUIRED_DLLS)

    extra = os.environ.get("BCL_WASM_EXTRA_DLLS", "")
    if extra:
        for name in extra.split(","):
            name = name.strip()
            if name and name not in selected:
                selected.append(name)

    result = []
    for name in selected:
        src = os.path.join(bcl_wasm_dir, name)
        if src.endswith(".so"):
            # Mono AOT 原生产物（<assembly>.dll.so），WASM 解释器模式不需要。
            continue
        if os.path.isfile(src):
            dst = "/lib/mono/4.5/" + name
            result.append((src, dst))
        else:
            print("[Mono] WASM: WARNING - BCL DLL not found: %s" % src)
    return result


def _embed_bcl_assemblies(env):
    """Embed BCL assemblies into WASM MEMFS via emcc --embed-file.

    [GodotExt] 2026-07-23 refactor (first principles):
    Old impl used `--embed-file dir@mount` to embed entire BCL dir (32MB):
      - mscorlib.dll.so (18MB Mono AOT native, already linked via static lib)
      - Microsoft.AspNetCore.*.dll / Microsoft.Extensions.*.dll (Blazor/DI)
      - System.Xml / System.Data / System.Web.Services (WCF/ADO.NET/MEF)
      - HelloWorld.dll (BCL WASM test sample)
    Caused ~18MB (.so) + 5MB (unrelated BCL) bloat.

    New impl uses `--embed-file file@mount` per-DLL embedding:
      - Whitelist (_BCL_WASM_REQUIRED_DLLS): mscorlib / System / System.Core / netstandard
      - Env var BCL_WASM_EXTRA_DLLS: user-specified extras (comma-separated)
      - Hard exclude: .so native libs

    [GodotExt] 2026-07-26 H9 fix: Also embed Facades/ subdirectory.
    netstandard2.0 BCL splits System.Runtime/System.Collections/etc into
    separate Facades/*.dll files. mono_host.cpp MONO_PATH includes
    `<bcl_dir>/Facades`, but the dir was not embedded -> runtime abort
    "Facades in MONO_PATH doesn't exist" + "Failed to load AOT module
    System ... dependency cannot be found".
    Fix: embed the Facades/ dir if it exists (only ~200KB total).

    CommandLine safety: each --embed-file pair ~80 bytes, 10 DLLs ~800B,
    well under Windows 32KB limit.
    """
    import os
    bcl_wasm_dir = _get_bcl_wasm_dir()
    if not (bcl_wasm_dir and os.path.isdir(bcl_wasm_dir)):
        print("[Mono] WASM: WARNING - BCL directory not found: '%s'. "
              "Set BCL_WASM_DIR env var or run setup_mono_windows.ps1." % bcl_wasm_dir)
        return

    dlls = _select_bcl_dlls(bcl_wasm_dir)
    if not dlls:
        print("[Mono] WASM: WARNING - no BCL DLLs selected from %s" % bcl_wasm_dir)
        return

    embed_flags = []
    for src, dst in dlls:
        embed_flags.extend(["--embed-file", src + "@" + dst])

    # H9 fix: Embed Facades/ subdirectory (System.Runtime/Collections/etc).
    # These are required by netstandard2.0 type forwarding. Without them,
    # Mono aborts when loading System module (depends on System.Runtime facade).
    facades_dir = os.path.join(bcl_wasm_dir, "Facades")
    if os.path.isdir(facades_dir):
        facades_dst = "/lib/mono/4.5/Facades"
        embed_flags.extend(["--embed-file", facades_dir + "@" + facades_dst])
        # Count facade DLLs for diagnostics.
        facade_files = [f for f in os.listdir(facades_dir)
                        if f.endswith(".dll") and os.path.isfile(os.path.join(facades_dir, f))]
        facades_mb = sum(os.path.getsize(os.path.join(facades_dir, f))
                         for f in facade_files) / (1024 * 1024)
        print("[Mono] WASM: Facades embedded (%d DLLs, %.2f MB) -> %s"
              % (len(facade_files), facades_mb, facades_dst))
    else:
        print("[Mono] WASM: WARNING - Facades/ subdirectory not found in %s. "
              "netstandard2.0 facade resolution will fail at runtime." % bcl_wasm_dir)

    env.Append(LINKFLAGS=embed_flags)

    total_mb = sum(os.path.getsize(s) for s, _ in dlls) / (1024 * 1024)
    dll_names = ", ".join(os.path.basename(s) for s, _ in dlls)
    print("[Mono] WASM: BCL assemblies embedded (%d DLLs, %.2f MB): %s"
          % (len(dlls), total_mb, dll_names))

    # Diagnostics: list excluded files (help identify missing DLLs).
    try:
        selected_srcs = {s for s, _ in dlls}
        all_files = [f for f in os.listdir(bcl_wasm_dir)
                     if os.path.isfile(os.path.join(bcl_wasm_dir, f))]
        excluded = [f for f in all_files
                    if os.path.join(bcl_wasm_dir, f) not in selected_srcs]
        if excluded:
            excluded_mb = sum(os.path.getsize(os.path.join(bcl_wasm_dir, f))
                              for f in excluded) / (1024 * 1024)
            print("[Mono] WASM: BCL excluded %d files (%.2f MB): %s"
                  % (len(excluded), excluded_mb, ", ".join(sorted(excluded))))
    except OSError:
        pass


def _apply_wasm_common_linkflags(env, env_mono):
    """Apply WASM link flags shared by both AOT and Interpreter modes.

    [GodotExt] 文档 §3.2 标准：Mono 6.12 WASM 静态库编译期已禁用 EH
    （通过 EMCC_CFLAGS=-sWASM_EXCEPTIONS=0，见 build_mono_wasm_lib.sh），
    链接期仅需保持 SUPPORT_LONGJMP=1（Mono 运行时需要 longjmp）和
    ERROR_ON_UNDEFINED_SYMBOLS=0（Mono 库引用 JS 侧函数）。

    历史问题：旧版静态库预编译时启用了 EH，导致微信 WXWebAssembly
    编译失败（Invalid opcode 0x06 try）。现通过重编静态库从根本解决，
    不再需要任何事后 strip（wasm-opt --strip-eh / Python strip section 13）。
    """
    wasm_threads = env.get("wasm_threads", False)
    if wasm_threads:
        env_mono.Append(CPPDEFINES=[("MONO_WASM_THREADS", 1)])
        env.Append(LINKFLAGS=[
            "-s", "PROXY_TO_PTHREAD=1",
            "-s", "PTHREAD_POOL_SIZE=4",
            "-s", "SHARED_MEMORY=1",
        ])
    else:
        env.Append(LINKFLAGS=[
            "-s", "PROXY_TO_PTHREAD=0",
            "-s", "PTHREAD_POOL_SIZE=0",
        ])

    wasm_memory = env.get("wasm_memory_size", 256)
    env.Append(LINKFLAGS=[
        "-s", "ALLOW_MEMORY_GROWTH=1",
        "-s", ("TOTAL_MEMORY=%dMB" % wasm_memory),
    ])

    # Mono WASM libraries reference JS-side functions; don't error on them.
    env.Append(LINKFLAGS=["-sERROR_ON_UNDEFINED_SYMBOLS=0"])
    # [GodotExt] 文档 §3.2: SUPPORT_LONGJMP=1 是 Mono 运行时核心需求
    # （Mono 用 longjmp 实现 C# 异常语义，不依赖 WASM EH 提案）。
    # 注意：emcc 4.0.1 中 WASM_EXCEPTIONS 是内部设置，不能通过 -s 设置。
    #   - 默认就是不启用 WASM EH（只有显式 -sWASM_EXCEPTIONS=1 才启用）
    #   - 静态库编译期已禁用 EH（见 build_mono_wasm_lib.sh），链接期无需再设
    env.Append(LINKFLAGS=["-sSUPPORT_LONGJMP=1"])

    return wasm_threads, wasm_memory


def _resolve_mono_lib_path(env, default_path):
    """Resolve Mono static library path.

    [GodotExt] 文档 §13.3: 支持通过 custom_mono_static_lib_path 参数
    指定自研重编的 Mono 静态库路径（禁用 EH 的纯净产物）。
    未指定时使用默认路径 #mono/libs/<platform>/<arch>。
    """
    custom = env.get("custom_mono_static_lib_path", "")
    if custom:
        import os
        # custom_mono_static_lib_path 指向单个 .a 文件，库目录为其父目录
        lib_dir = os.path.dirname(custom)
        if os.path.isdir(lib_dir):
            print("[Mono] Using custom Mono static lib dir: %s" % lib_dir)
            return lib_dir
        else:
            print("[Mono] WARNING: custom_mono_static_lib_path dir not found: %s, "
                  "falling back to default" % lib_dir)
    return default_path


def _run_aot_workflow(env, env_mono, mono_sources_list):
    """Full AOT workflow: compile DLLs, AOT compile, generate registration code, link."""
    import os
    import sys
    import subprocess
    import shutil
    from pathlib import Path

    project_root = Dir("#").abspath

    # 1. Detect cross-compiler
    # WASM-specific cross-compiler (built with --target=wasm32-unknown-none)
    # Falls back to x86_64 cross-compiler for non-WASM platforms
    mono_aot_cross = os.environ.get("MONO_AOT_CROSS",
        "/opt/mono-aot-cross-wasm/bin/mono")
    if not os.path.exists(mono_aot_cross):
        # Try x86_64 fallback
        mono_aot_cross = os.environ.get("MONO_AOT_CROSS_X64",
            "/opt/mono-aot-cross/bin/mono-aot-cross")
    if not os.path.exists(mono_aot_cross):
        raise SCons.Errors.StopError(
            "mono-aot-cross not found. Build it from Mono 6.12 source with LLVM 10"
            " WASM backend (see docs/superpowers/specs/2026-07-14-mono-full-aot-workflow-design.md)."
            " Expected at /opt/mono-aot-cross-wasm/bin/mono-aot-cross or /opt/mono-aot-cross/bin/mono-aot-cross.")

    # 2. Determine DLL paths (BCL dir resolved via shared helper)
    bcl_dir = _get_bcl_wasm_dir()
    if not bcl_dir or not os.path.isdir(bcl_dir):
        # AOT-specific fallback: WSL path
        bcl_dir = "/e/workspace/godot/mono-wasm-output/bcl/lib/mono/4.5"

    godotsharp_dll = os.path.join(project_root, "build_godotsharp", "GodotSharp.dll")
    projectscripts_dll = os.path.join(project_root, "csharp_test", "ProjectScripts.dll")

    if not os.path.exists(godotsharp_dll):
        raise SCons.Errors.StopError(
            "GodotSharp.dll not found at %s" % godotsharp_dll)
    if not os.path.exists(projectscripts_dll):
        print("[Mono] AOT WARNING: ProjectScripts.dll not found, AOT will skip user assembly")

    # 3. Setup AOT cache directory
    aot_cache = os.path.join(project_root, "mono", "aot-cache")
    os.makedirs(aot_cache, exist_ok=True)

    # 4. Incremental build check
    # M5 fix: build asm_name -> dll_path map (BCL + user), pass to check_cache_stale.
    # Previously passed a flat dll_paths list (BCL excluded) and update_cache_hash
    # inferred DLL path from obj_path (always failed) → cache never hit.
    cache_hash_file = os.path.join(aot_cache, ".cache_hashes.json")
    dll_path_map = {}
    for bcl_dll in ["mscorlib.dll", "System.dll", "System.Core.dll"]:
        bcl_p = os.path.join(bcl_dir, bcl_dll)
        if os.path.exists(bcl_p):
            dll_path_map[bcl_dll.replace(".dll", "")] = bcl_p
    if os.path.exists(godotsharp_dll):
        dll_path_map["GodotSharp"] = godotsharp_dll
    if os.path.exists(projectscripts_dll):
        dll_path_map["ProjectScripts"] = projectscripts_dll

    need_rebuild = True
    try:
        sys.path.insert(0, os.path.join(project_root, "tools"))
        from aot_compile import check_cache_stale
        need_rebuild = check_cache_stale(cache_hash_file, dll_path_map)
    except Exception as e:
        print("[Mono] AOT: Cache check failed (%s), forcing rebuild" % str(e))

    if need_rebuild:
        print("[Mono] AOT: Starting Full AOT compilation workflow...")

        # 5. Call aot_compile.py
        cmd = [
            sys.executable,
            os.path.join(project_root, "tools", "aot_compile.py"),
            "--mono-aot-cross", mono_aot_cross,
            "--bcl-dir", bcl_dir,
            "--assemblies", "GodotSharp.dll" +
                (",ProjectScripts.dll" if os.path.exists(projectscripts_dll) else ""),
            "--assembly-dir", os.path.dirname(godotsharp_dll),
            "--output-dir", aot_cache,
            "--platform", "wasm",
            "--aot-opts", "full,static,direct-icalls,llvmonly,asmonly,no-opt,deterministic,trampolines=4096",
            "--extract-generics",
            "--source-dirs", os.path.join(project_root, "build_godotsharp") +
                "," + os.path.join(project_root, "csharp_test"),
            "--manual-roots", os.path.join(project_root, "build_godotsharp", "GenericRoots.manual.cs"),
            "--cache-hash-file", cache_hash_file,
        ]

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if result.returncode != 0:
            raise SCons.Errors.StopError(
                "AOT compilation failed:\n%s\n%s" % (result.stdout, result.stderr))
        print(result.stdout)
    else:
        print("[Mono] AOT: Cache up-to-date, skipping AOT compilation.")

    # 6. Replace mono_aot_modules.cpp with generated version
    gen_cpp = os.path.join(aot_cache, "mono_aot_modules.gen.cpp")
    if os.path.exists(gen_cpp):
        target_cpp = os.path.join(project_root, "modules", "mono",
                                   "mono_aot_modules.gen.cpp")
        shutil.copy2(gen_cpp, target_cpp)
        if "mono_aot_modules.cpp" in mono_sources_list:
            mono_sources_list.remove("mono_aot_modules.cpp")
        if "mono_aot_modules.gen.cpp" not in mono_sources_list:
            mono_sources_list.append("mono_aot_modules.gen.cpp")
        print("[Mono] AOT: Using generated module table: %s" % target_cpp)
    else:
        raise SCons.Errors.StopError(
            "AOT module table not generated: %s" % gen_cpp)

    # 7. Recompile ProjectScripts.dll with GenericRoots.gen.cs
    gen_roots_cs = os.path.join(aot_cache, "GenericRoots.gen.cs")
    if os.path.exists(gen_roots_cs):
        _recompile_projectscripts_with_roots(env, project_root, gen_roots_cs)


def _recompile_projectscripts_with_roots(env, project_root, gen_roots_cs):
    """Recompile ProjectScripts.dll with GenericRoots.gen.cs included."""
    import os
    import subprocess

    csc = r"C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
    if not os.path.exists(csc):
        csc = "csc"

    godotsharp_dll = os.path.join(project_root, "build_godotsharp", "GodotSharp.dll")
    netstandard = r"C:\Program Files\Mono\lib\mono\4.5\Facades\netstandard.dll"
    csharp_test_dir = os.path.join(project_root, "csharp_test")
    output_dll = os.path.join(project_root, "csharp_test", "ProjectScripts.dll")

    attr_cs = os.path.join(project_root, "build_godotsharp", "MonoAotGenericAttribute.cs")
    manual_cs = os.path.join(project_root, "build_godotsharp", "GenericRoots.manual.cs")

    cmd = [
        csc, "/target:library",
        "/out:" + output_dll,
        "/reference:" + godotsharp_dll,
        "/nologo",
    ]
    if os.path.exists(netstandard):
        cmd.append("/reference:" + netstandard)
    # Auto-include all .cs files in csharp_test (Test.cs, Game2048.cs, etc.)
    if os.path.isdir(csharp_test_dir):
        for fname in sorted(os.listdir(csharp_test_dir)):
            if fname.endswith(".cs"):
                cmd.append(os.path.join(csharp_test_dir, fname))
    if os.path.exists(attr_cs):
        cmd.append(attr_cs)
    if os.path.exists(manual_cs):
        cmd.append(manual_cs)
    cmd.append(gen_roots_cs)

    print("[Mono] AOT: Recompiling ProjectScripts.dll with GenericRoots...")
    result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if result.returncode != 0:
        raise SCons.Errors.StopError(
            "ProjectScripts.dll recompilation failed:\n%s\n%s" % (result.stdout, result.stderr))
    print("[Mono] AOT: ProjectScripts.dll recompiled (%d bytes)" % os.path.getsize(output_dll))


if env["platform"] == "windows":
    env_mono.Append(CPPDEFINES=[
        ("MONO_JIT_MODE", 1),
        ("_CRT_SECURE_NO_WARNINGS", 1),
    ])

    import os
    mono_install_lib = "C:/Program Files/Mono/lib"
    local_mono_lib = mono_root + "/libs/windows/x64"
    
    if os.path.isdir(mono_install_lib):
        mono_lib_path = mono_install_lib
    else:
        mono_lib_path = local_mono_lib
    
    env.Prepend(LIBPATH=[mono_lib_path])
    env_mono.Prepend(LIBPATH=[mono_lib_path])

    if env.msvc:
        # Use the static Mono library to produce a DLL-less executable.
        # libmono-static-sgen.lib (~29MB) contains the full Mono SGen runtime;
        # mono-2.0-sgen.lib (~274KB) is only an import library for the DLL.
        #
        # The Mono static lib was compiled with /MD (dynamic CRT) and uses
        # __declspec(dllimport) for CRT functions, producing __imp_ prefixed
        # symbol references. mono_static_compat.c embeds /ALTERNATENAME
        # linker directives via #pragma comment(linker, ...) to redirect
        # these to statically-linked CRT functions.
        env.Append(LINKFLAGS=[
            "libmono-static-sgen.lib",
            "MonoPosixHelper.lib",
            "ws2_32.lib",
            "psapi.lib",
            "version.lib",
            "winmm.lib",
            "bcrypt.lib",
            "ole32.lib",
            "oldnames.lib",
        ])
        # Add the static-compat shim (provides __imp_ → CRT name redirects)
        mono_sources.append("mono_static_compat.c")
    else:
        env.Append(LIBS=[
            "mono-2.0-sgen",
            "MonoPosixHelper",
            "ws2_32",
            "psapi",
            "version",
            "winmm",
            "bcrypt",
            "ole32",
            "oldnames",
        ])

elif env["platform"] in ["x11", "linuxbsd"]:
    env_mono.Append(CPPDEFINES=[
        ("MONO_JIT_MODE", 1),
    ])
    mono_lib_path = mono_root + "/libs/linux/x64"
    env.Prepend(LIBPATH=[mono_lib_path])
    env_mono.Prepend(LIBPATH=[mono_lib_path])
    # 静态链接 Mono SGen runtime（与 Windows 一致策略）
    # Linux Clang/GCC 不产生 __imp_ 前缀，无需 mono_static_compat.c
    # 顺序：mono-native 必须用 --whole-archive 强制包含所有 .o
    # （否则未引用的 SystemNative_* 符号会被 ld 丢弃，运行时 dlsym
    # 找不到 SystemNative_LChflagsCanSetHiddenFlag 等函数，导致
    # System.Random 等 BCL 类型 DllNotFoundException）
    env.Append(LIBS=[
        "monosgen-2.0",   # libmonosgen-2.0.a（SGen GC runtime）
        "monoutils",       # libmonoutils.a（工具库）
        "eglib",           # libeglib.a（Mono 基础库）
    ])
    # libmono-native.a 包含 Unix System.Native interop（LChflags/GetRandomBytes 等）
    # 缺失会导致 .NET Core BCL 静态构造器 TypeInit 异常（System.Random 等）
    # 见 mono.config: dllmap System.Native -> __Internal
    # 必须用 --whole-archive 强制包含所有 .o（否则未引用符号会被 ld 丢弃，
    # 运行时 dlsym 找不到 SystemNative_LChflagsCanSetHiddenFlag 等函数）
    env.Append(LINKFLAGS=[
        "-Wl,--whole-archive",
        "-lmono-native",
        "-Wl,--no-whole-archive",
    ])
    env.Append(LIBS=[
        "pthread", "dl", "m", "rt",
        # GSSAPI/Kerberos 系统库：libmono-native.a 的 pal_gssapi.o 引用
        # gss_* / GSS_C_* 符号（System.Net.Security.Native 依赖）。
        # --whole-archive 强制包含 pal_gssapi.o，必须链接这些系统库。
        # 仅 Linux 平台原生系统库，允许动态链接（与 Windows 链接 ws2_32.dll
        # 等系统 DLL 等价策略）。Godot 游戏运行时不调用 GSSAPI，但链接器
        # 需要解析符号以生成可执行文件。
        "gssapi_krb5", "krb5", "k5crypto", "com_err",
        # 注意：Linux/glibc 中 iconv 是 libc 的一部分，无需 -liconv
        # macOS 才需要单独链接 libiconv（见下方 macos 分支）
    ])
    # 导出可执行文件符号到动态符号表，使 mono 的 __Internal dllmap
    # 能通过 dlsym(RTLD_DEFAULT, ...) 找到 libmono-native.a 的 SystemNative_*
    # 符号（如 SystemNative_LChflagsCanSetHiddenFlag / SystemNative_GetRandomBytes）。
    # 缺失会导致 System.Random 等 BCL 类型 DllNotFoundException。
    env.Append(LINKFLAGS=["-Wl,--export-dynamic"])

elif env["platform"] == "macos":
    env_mono.Append(CPPDEFINES=[
        ("MONO_JIT_MODE", 1),
    ])
    mono_lib_path = mono_root + "/libs/macos/universal"
    env.Prepend(LIBPATH=[mono_lib_path])
    env_mono.Prepend(LIBPATH=[mono_lib_path])
    # 静态链接 Mono SGen runtime（universal .a 文件，x64+arm64）
    env.Append(LIBS=[
        "monosgen-2.0",
        "monoutils",
        "eglib",
    ])
    # macOS ld64 不支持 --whole-archive，使用 -force_load 强制包含全部对象
    # （语义等价于 GNU ld 的 --whole-archive -l<lib> --no-whole-archive）
    env.Append(LINKFLAGS=[
        "-Wl,-force_load," + mono_lib_path + "/libmono-native.a",
    ])
    env.Append(LIBS=[
        "-framework", "Foundation",
        "-framework", "CoreFoundation",
        "iconv",
    ])
    # macOS ld64 使用 -export_dynamic 导出符号（语义同 Linux --export-dynamic）
    env.Append(LINKFLAGS=["-Wl,-export_dynamic"])

elif env["platform"] == "ios":
    # iOS Mono 支持（Interpreter 模式，Apple App Store 禁止 JIT）
    #
    # iOS 限制：
    #   - 不允许 JIT（App Store 政策 + iOS 沙箱 W^X 内存保护）
    #   - 应用必须静态库（不能动态库，最终打包成 .app）
    #   - 必须使用 Full AOT 模式或 Interpreter 模式
    #
    # 阶段 1 实现：Interpreter 模式
    #   - Apple 2020+ 允许 interpreter-only iOS 应用
    #   - 无需 AOT 交叉编译工具链（mono-aot-cross-ios）
    #   - 与 WASM Interpreter 分支结构一致
    # TODO 阶段 2：Full AOT 模式（待 mono-aot-cross-ios 工具链 + Mac 硬件验证）
    #
    # 链接策略：静态链接 + -force_load（Apple ld64，与 macOS 一致）
    env_mono.Append(CPPDEFINES=[
        ("MONO_INTERP_MODE", 1),
        ("MONO_STATIC", 1),
    ])

    # iOS 架构映射
    # arm64: iOS device + Apple Silicon (M1+) Mac simulator
    # x86_64: Intel Mac simulator（仅开发调试，App Store 不需要）
    ios_arch = env.get("arch", "arm64")
    arch_map = {
        "arm64": "arm64",
        "x86_64": "x86_64",
    }
    mono_arch = arch_map.get(ios_arch, "arm64")
    mono_lib_path = mono_root + "/libs/ios/" + mono_arch

    env.Prepend(LIBPATH=[mono_lib_path])
    env_mono.Prepend(LIBPATH=[mono_lib_path])

    # Interpreter 模式需要的 Mono 库（与 WASM Interpreter 一致）
    # mini: Mono JIT 编译器核心（包含 AOT/Interpreter 入口）
    # monoruntimesgen: SGen GC runtime
    # monosgen-2.0: SGen GC 主库
    # mono-ee-interp: Interpreter 引擎（解释执行 IL）
    # mono-ilgen: IL 生成器（Interpreter 运行时 IL 构建）
    # monoutils: Mono 工具库
    # eglib: Mono 基础库（glib 替代）
    # mono-profiler-aot: AOT profiler（用于 AOT 模式分析，Interpreter 模式也链接）
    env.Append(LIBS=[
        "mini",
        "monoruntimesgen",
        "monosgen-2.0",
        "mono-ee-interp",
        "mono-ilgen",
        "monoutils",
        "eglib",
        "mono-profiler-aot",
    ])

    # libmono-native.a 必须用 -force_load 强制包含所有 .o
    # （Apple ld64 不支持 GNU ld 的 --whole-archive；-force_load 是 Apple 等价物）
    # 与 macOS 分支一致策略：否则 SystemNative_* 符号被 linker 丢弃，
    # 运行时 dlsym 找不到 SystemNative_GetRandomBytes 等函数，
    # 导致 System.Random 等 BCL 类型 DllNotFoundException。
    env.Append(LINKFLAGS=[
        "-Wl,-force_load," + mono_lib_path + "/libmono-native.a",
    ])

    # iOS 系统库（与 macOS 一致）
    # Foundation / CoreFoundation: Mono 运行时基础（NSString, NSDate, NSDateFormatter 等）
    # iconv: Mono 字符编码转换（System.Text.Encoding 依赖）
    # 注意：iOS 通过 -framework 链接（Apple 平台标准方式）
    env.Append(LIBS=[
        "-framework", "Foundation",
        "-framework", "CoreFoundation",
        "iconv",
    ])

    # 注意：iOS 最终产物是 libgodot.a（静态归档），不是可执行文件。
    # -export_dynamic 仅对可执行文件有效，对 .a 无意义。
    # 符号导出由最终 .app 链接时的 Xcode 项目处理（见 platform/ios/export/export_plugin.cpp）。

elif env["platform"] == "android":
    # Android 原生 Mono 支持（JIT 模式，静态链接 libmonosgen-2.0.a + libmono-native.a）
    # 策略与 Linux 桌面一致：全静态链接，--whole-archive 强制包含 libmono-native.a
    env_mono.Append(CPPDEFINES=[("MONO_JIT_MODE", 1)])

    # Android ABI 映射：Godot arch -> Mono libs 子目录
    android_abi = env["arch"]
    abi_map = {
        "arm64": "arm64-v8a",
        "arm32": "armeabi-v7a",
        "x86_32": "x86",
        "x86_64": "x86_64",
    }
    mono_abi = abi_map.get(android_abi, "arm64-v8a")
    mono_lib_path = mono_root + "/libs/android/" + mono_abi

    env.Prepend(LIBPATH=[mono_lib_path])
    env_mono.Prepend(LIBPATH=[mono_lib_path])

    # 静态链接 Mono SGen runtime（与 Linux 桌面一致策略）
    env.Append(LIBS=[
        "monosgen-2.0",   # libmonosgen-2.0.a（SGen GC runtime）
        "monoutils",       # libmonoutils.a（工具库）
        "eglib",           # libeglib.a（Mono 基础库）
    ])

    # libmono-native.a 必须用 --whole-archive 强制包含所有 .o
    # （与 Linux 桌面相同模式：否则 SystemNative_* 符号被 linker 丢弃，
    # 运行时 dlsym 找不到 SystemNative_GetRandomBytes 等函数，
    # 导致 System.Random 等 BCL 类型 DllNotFoundException）
    env.Append(LINKFLAGS=[
        "-Wl,--whole-archive",
        "-lmono-native",
        "-Wl,--no-whole-archive",
    ])

    # Android NDK 系统库
    # log: __android_log_print（Mono 运行时日志输出到 logcat）
    # android: AssetManager（Godot 文件访问）
    # dl: dlsym（Mono __Internal dllmap 符号查找）
    # m: 数学库（Mono 运行时数学运算）
    # z: zlib（Mono 内部压缩）
    env.Append(LIBS=["log", "android", "dl", "m", "z"])

    # 导出符号到动态符号表，使 mono 的 __Internal dllmap
    # 能通过 dlsym(RTLD_DEFAULT, ...) 找到 libmono-native.a 的符号
    # （与 Linux 桌面一致的 --export-dynamic 策略）
    env.Append(LINKFLAGS=["-Wl,--export-dynamic"])

elif env["platform"] == "web":
    common_defines = [
        ("MONO_STATIC", 1),
        ("WEB_ENABLED", 1),
        ("DISABLE_SOCKET", 1),
        ("MONO_SINGLE_THREAD", 1),
    ]

    if env.get("mono_aot", False):
        # ========================================
        # Full AOT mode (Hybrid: AOT + Interpreter fallback)
        # ========================================
        env_mono.Append(CPPDEFINES=common_defines + [
            ("MONO_AOT_MODE", 1),
            ("MONO_INTERP_MODE", 1),
            ("MONO_AOT_HYBRID", 1),
        ])

        print("[Mono] WASM platform: Full AOT mode (Hybrid with Interpreter fallback)")

        # Run AOT workflow: compile DLLs, generate registration code
        # Skip if MONO_AOT_PRECOMPILED=1 (AOT objects already compiled in WSL)
        import os as _os_mod
        if _os_mod.environ.get("MONO_AOT_PRECOMPILED", "") == "1":
            print("[Mono] AOT: Using pre-compiled AOT objects (MONO_AOT_PRECOMPILED=1)")
            # Use the hand-maintained mono_aot_modules.cpp (tracked in git).
            # No need to swap in a generated .gen.cpp — the .cpp file already
            # contains the correct hybrid AOT module table for this configuration.
            print("[Mono] AOT: Using hand-maintained module table: mono_aot_modules.cpp")
        else:
            _run_aot_workflow(env, env_mono, mono_sources)

        # Keep Interpreter libraries for Hybrid fallback
        mono_lib_path = _resolve_mono_lib_path(env, mono_root + "/libs/web/wasm")
        env.Prepend(LIBPATH=[mono_lib_path])
        env.Append(LIBS=[
            "mini",
            "monoruntimesgen",
            "monosgen-2.0",
            "mono-ee-interp",
            "mono-ilgen",
            "monoutils",
            "eglib",
            "mono-profiler-aot",
        ])

        # Link AOT-compiled .o files
        import os
        from glob import glob as glob_glob
        aot_obj_dir = Dir("#mono/aot-cache").abspath
        if os.path.isdir(aot_obj_dir):
            aot_objects = []
            for obj_file in sorted(glob_glob(os.path.join(aot_obj_dir, "*.o"))):
                aot_objects.append(env.File(obj_file))
            if aot_objects:
                env.Prepend(LIBS=aot_objects)
                print("[Mono] AOT: Linked %d AOT object files" % len(aot_objects))

        # Common WASM link flags (shared helper)
        wasm_threads, wasm_memory = _apply_wasm_common_linkflags(env, env_mono)
        print("[Mono] WASM AOT: threads=%s, memory=%dMB"
              % ("yes" if wasm_threads else "no", wasm_memory))

        wasm_glue = env_mono.Object(source="#modules/mono/mono_wasm_glue.cpp")
        env.Prepend(LIBS=[wasm_glue])

        # Embed BCL assemblies into WASM MEMFS
        _embed_bcl_assemblies(env)

    else:
        # ========================================
        # Interpreter mode (existing, default)
        # ========================================
        env_mono.Append(CPPDEFINES=common_defines + [
            ("MONO_INTERP_MODE", 1),
        ])

        mono_lib_path = _resolve_mono_lib_path(env, mono_root + "/libs/web/wasm")
        env.Prepend(LIBPATH=[mono_lib_path])
        env_mono.Prepend(LIBPATH=[mono_lib_path])

        env.Append(LIBS=[
            "mini",
            "monoruntimesgen",
            "monosgen-2.0",
            "mono-ee-interp",
            "mono-ilgen",
            "monoutils",
            "eglib",
            "mono-profiler-aot",
        ])

        # Common WASM link flags (shared helper)
        wasm_threads, wasm_memory = _apply_wasm_common_linkflags(env, env_mono)
        print("[Mono] WASM platform: Interpreter mode configured (threads=%s, memory=%dMB)"
              % ("yes" if wasm_threads else "no", wasm_memory))

        # Provide mono_wasm_enable_gc stub (required by SGEN GC, not handled by
        # --import-undefined because it's referenced from within a library).
        wasm_glue = env_mono.Object(source="#modules/mono/mono_wasm_glue.cpp")
        env.Prepend(LIBS=[wasm_glue])

        # Embed BCL assemblies into WASM MEMFS
        _embed_bcl_assemblies(env)

env_mono.add_source_files(env.modules_sources, mono_sources)

# A1: C# script templates (editor-only). 遵循 GDScript 模块与旧 mono 提交
# (1963b2f) 的实际模式：主 SCsub 用 `if env.editor_build:` 包裹 SConscript，
# 子 SCsub 内部不包裹。spec §1.2 修订 #01 描述的"主 SCsub 无条件 SConscript
# + 子 SCsub 内部 if env['tools']: 包裹"与 GDScript 实际不符（评审遗漏），
# 故按 Godot 项目标准做法实施。
# [REV-2026-07-25-#01 偏差记录]：源文件追加仍遵循 #01（无条件列入
# mono_sources，由 C++ 内部 #ifdef TOOLS_ENABLED 裁剪）；但 SConscript
# 子目录调用是 .gen.h 生成触发器，不属于源文件裁剪范畴，应用
# env.editor_build 包裹以避免运行时构建生成无用 templates.gen.h。
if env.editor_build:
    SConscript("editor/script_templates/SCsub")

# A4: SemVer 单元测试。遵循 Godot 模块测试标准模式（参考 modules/gdscript/SCsub、
# modules/multiplayer/SCsub）：当 scons tests=yes 时，将 ./tests/*.cpp 加入
# env.modules_sources，由 tests/SCsub 统一链接进 tests 库。
# 运行：godot --test "[SemVer]"
if env["tests"]:
    env_mono.add_source_files(env.modules_sources, "./tests/*.cpp")

print("[Mono] Configured for platform: " + env["platform"])

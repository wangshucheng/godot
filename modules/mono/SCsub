elif env["platform"] == "web":
    common_defines = [
        ("MONO_STATIC", 1),
        ("WEB_ENABLED", 1),
        ("DISABLE_SOCKET", 1),
        ("MONO_SINGLE_THREAD", 1),
    ]

    if env.get("mono_aot", False):
        # ========================================
        # Full AOT mode (Hybrid: AOT + Interpreter fallback)
        # ========================================
        env_mono.Append(CPPDEFINES=common_defines + [
            ("MONO_AOT_MODE", 1),
            ("MONO_INTERP_MODE", 1),
            ("MONO_AOT_HYBRID", 1),
        ])

        print("[Mono] WASM platform: Full AOT mode (Hybrid with Interpreter fallback)")

        # Run AOT workflow: compile DLLs, generate registration code
        # Skip if MONO_AOT_PRECOMPILED=1 (AOT objects already compiled in WSL)
        import os as _os_mod
        if _os_mod.environ.get("MONO_AOT_PRECOMPILED", "") == "1":
            print("[Mono] AOT: Using pre-compiled AOT objects (MONO_AOT_PRECOMPILED=1)")
            # Use generated module table if it exists
            _gen_cpp_path = _os_mod.path.join(str(Dir("#").abspath), "modules", "mono", "mono_aot_modules.gen.cpp")
            if _os_mod.path.exists(_gen_cpp_path):
                if "mono_aot_modules.cpp" in mono_sources:
                    mono_sources.remove("mono_aot_modules.cpp")
                if "mono_aot_modules.gen.cpp" not in mono_sources:
                    mono_sources.append("mono_aot_modules.gen.cpp")
                print("[Mono] AOT: Using pre-generated module table: %s" % _gen_cpp_path)
            else:
                print("[Mono] AOT WARNING: mono_aot_modules.gen.cpp not found, using default")
        else:
            _run_aot_workflow(env, env_mono, mono_sources)

        # Keep Interpreter libraries for Hybrid fallback
        mono_lib_path = mono_root + "/libs/web/wasm"
        env.Prepend(LIBPATH=[mono_lib_path])
        env.Append(LIBS=[
            "mini",
            "monoruntimesgen",
            "monosgen-2.0",
            "mono-ee-interp",
            "mono-ilgen",
            "monoutils",
            "eglib",
            "mono-profiler-aot",
        ])

        # Link AOT-compiled .o files
        import os
        from glob import glob as glob_glob
        aot_obj_dir = Dir("#mono/aot-cache").abspath
        if os.path.isdir(aot_obj_dir):
            aot_objects = []
            for obj_file in sorted(glob_glob(os.path.join(aot_obj_dir, "*.o"))):
                aot_objects.append(env.File(obj_file))
            if aot_objects:
                env.Prepend(LIBS=aot_objects)
                print("[Mono] AOT: Linked %d AOT object files" % len(aot_objects))

        # Common WASM link flags (shared by both modes)
        wasm_threads = env.get("wasm_threads", False)
        if wasm_threads:
            env_mono.Append(CPPDEFINES=[("MONO_WASM_THREADS", 1)])
            env.Append(LINKFLAGS=[
                "-s", "PROXY_TO_PTHREAD=1",
                "-s", "PTHREAD_POOL_SIZE=4",
                "-s", "SHARED_MEMORY=1",
            ])
        else:
            env.Append(LINKFLAGS=[
                "-s", "PROXY_TO_PTHREAD=0",
                "-s", "PTHREAD_POOL_SIZE=0",
            ])

        wasm_memory = env.get("wasm_memory_size", 256)
        env.Append(LINKFLAGS=[
            "-s", "ALLOW_MEMORY_GROWTH=1",
            "-s", ("TOTAL_MEMORY=%dMB" % wasm_memory),
        ])

        print("[Mono] WASM AOT: threads=%s, memory=%dMB"
              % ("yes" if wasm_threads else "no", wasm_memory))

        env.Append(LINKFLAGS=["-sERROR_ON_UNDEFINED_SYMBOLS=0"])
        env.Append(LINKFLAGS=["-sDISABLE_EXCEPTION_THROWING=0"])
        env.Append(LINKFLAGS=["-sDISABLE_EXCEPTION_CATCHING=0"])
        env.Append(LINKFLAGS=["-sSUPPORT_LONGJMP=emscripten"])

        wasm_glue = env_mono.Object(source="#modules/mono/mono_wasm_glue.cpp")
        env.Prepend(LIBS=[wasm_glue])

        # Embed BCL assemblies into WASM MEMFS via emcc --embed-file
        bcl_wasm_dir = os.environ.get("BCL_WASM_DIR", "")
        if not bcl_wasm_dir:
            bcl_wasm_dir = os.path.normpath(os.path.join(str(Dir("#").abspath), "..", "mono-wasm-output", "bcl", "lib", "mono"))
        if not os.path.isdir(bcl_wasm_dir):
            bcl_wasm_dir = r"E:\workspace\godot\mono-wasm-output\bcl\lib\mono"
        if os.path.isdir(bcl_wasm_dir):
            env.Append(LINKFLAGS=[
                "--embed-file", bcl_wasm_dir + "@/lib/mono",
            ])
            print("[Mono] WASM AOT: BCL assemblies embedded from %s" % bcl_wasm_dir)
        else:
            print("[Mono] WASM AOT: WARNING - BCL directory not found at %s" % bcl_wasm_dir)

    else:
        # ========================================
        # Interpreter mode (existing, default)
        # ========================================
        env_mono.Append(CPPDEFINES=common_defines + [
            ("MONO_INTERP_MODE", 1),
        ])

        mono_lib_path = mono_root + "/libs/web/wasm"
        env.Prepend(LIBPATH=[mono_lib_path])
        env_mono.Prepend(LIBPATH=[mono_lib_path])

        env.Append(LIBS=[
            "mini",
            "monoruntimesgen",
            "monosgen-2.0",
            "mono-ee-interp",
            "mono-ilgen",
            "monoutils",
            "eglib",
            "mono-profiler-aot",
        ])

        wasm_threads = env.get("wasm_threads", False)
        if wasm_threads:
            env_mono.Append(CPPDEFINES=[("MONO_WASM_THREADS", 1)])
            env.Append(LINKFLAGS=[
                "-s", "PROXY_TO_PTHREAD=1",
                "-s", "PTHREAD_POOL_SIZE=4",
                "-s", "SHARED_MEMORY=1",
            ])
        else:
            env.Append(LINKFLAGS=[
                "-s", "PROXY_TO_PTHREAD=0",
                "-s", "PTHREAD_POOL_SIZE=0",
            ])

        wasm_memory = env.get("wasm_memory_size", 256)
        env.Append(LINKFLAGS=[
            "-s", "ALLOW_MEMORY_GROWTH=1",
            "-s", ("TOTAL_MEMORY=%dMB" % wasm_memory),
        ])

        print("[Mono] WASM platform: Interpreter mode configured (threads=%s, memory=%dMB)"
              % ("yes" if wasm_threads else "no", wasm_memory))

        # Don't error on undefined symbols - the Mono WASM libraries reference
        # JavaScript-side functions (mono_wasm_*, mono_set_timeout) that are
        # normally provided by the Mono WASM driver. We don't need them since
        # we use interpreter mode, and they'll be resolved as JS imports at runtime.
        env.Append(LINKFLAGS=["-sERROR_ON_UNDEFINED_SYMBOLS=0"])

        # Enable C++ exception support - the Mono runtime libraries require it.
        # Must use SUPPORT_LONGJMP=emscripten (not 'wasm') with exceptions enabled.
        env.Append(LINKFLAGS=["-sDISABLE_EXCEPTION_THROWING=0"])
        env.Append(LINKFLAGS=["-sDISABLE_EXCEPTION_CATCHING=0"])
        env.Append(LINKFLAGS=["-sSUPPORT_LONGJMP=emscripten"])

        # Provide mono_wasm_enable_gc stub (required by SGEN GC, not handled by
        # --import-undefined because it's referenced from within a library).
        wasm_glue = env_mono.Object(source="#modules/mono/mono_wasm_glue.cpp")
        env.Prepend(LIBS=[wasm_glue])

        # Embed BCL assemblies into WASM MEMFS via emcc --embed-file.
        # BCL .dll files are accessible at /lib/mono/ in MEMFS at runtime.
        # Path resolution order:
        #   1. BCL_WASM_DIR environment variable (absolute path)
        #   2. <GodotSource>/../mono-wasm-output/bcl/lib/mono (legacy layout)
        #   3. E:\workspace\godot\mono-wasm-output\bcl\lib\mono (default SDK path)
        import os
        bcl_wasm_dir = os.environ.get("BCL_WASM_DIR", "")
        if not bcl_wasm_dir:
            bcl_wasm_dir = os.path.normpath(os.path.join(str(Dir("#").abspath), "..", "mono-wasm-output", "bcl", "lib", "mono"))
        if not os.path.isdir(bcl_wasm_dir):
            bcl_wasm_dir = r"E:\workspace\godot\mono-wasm-output\bcl\lib\mono"
        if os.path.isdir(bcl_wasm_dir):
            env.Append(LINKFLAGS=[
                "--embed-file", bcl_wasm_dir + "@/lib/mono",
            ])
            print("[Mono] WASM: BCL assemblies embedded from %s" % bcl_wasm_dir)
        else:
            print("[Mono] WASM: WARNING - BCL directory not found at %s" % bcl_wasm_dir)

env_mono.add_source_files(env.modules_sources, mono_sources)

print("[Mono] Configured for platform: " + env["platform"])

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>CSharpTest</AssemblyName>
    <RootNamespace>CSharpTest</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath>.mono/assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>..\bin\GodotSharp\Api\Debug\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\csharp_bench\CSharpBench.Core\CSharpBench.Core.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>
  <!-- Exclude BCL (mono/) and Gradle build output (android/) from C# compilation.
       These directories contain .dll and .cs files that should be included in the
       PCK export but must not be compiled as part of the project. -->
  <ItemGroup>
    <Compile Remove="mono\**\*" />
    <Compile Remove="android\**\*" />
  </ItemGroup>
</Project>

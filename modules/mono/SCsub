def _get_bcl_wasm_dir():
    """Resolve BCL directory for WASM embedding (env var > project-local fallback)."""
    import os
    bcl_dir = os.environ.get("BCL_WASM_DIR", "")
    if bcl_dir and os.path.isdir(bcl_dir):
        return bcl_dir
    # Fallback: project-local mono BCL (prepared by setup_mono_windows.ps1)
    local_bcl = os.path.join(str(Dir("#").abspath), "mono", "lib", "mono", "4.5")
    if os.path.isdir(local_bcl):
        return local_bcl
    return bcl_dir  # Return whatever was set (may be empty/invalid)


def _embed_bcl_assemblies(env):
    """Embed BCL assemblies into WASM MEMFS via emcc --embed-file."""
    import os
    from glob import glob
    bcl_wasm_dir = _get_bcl_wasm_dir()
    if bcl_wasm_dir and os.path.isdir(bcl_wasm_dir):
        bcl_dlls = sorted(glob(os.path.join(bcl_wasm_dir, "*.dll")))
        for dll in bcl_dlls:
            dll_name = os.path.basename(dll)
            env.Append(LINKFLAGS=[
                "--embed-file", dll + "@/lib/mono/4.5/" + dll_name,
            ])
        print("[Mono] WASM: BCL assemblies embedded from %s (%d DLLs, %.1f MB)"
              % (bcl_wasm_dir, len(bcl_dlls),
                 sum(os.path.getsize(d) for d in bcl_dlls) / (1024*1024)))
    else:
        print("[Mono] WASM: WARNING - BCL directory not found: '%s'. "
              "Set BCL_WASM_DIR env var or run setup_mono_windows.ps1." % bcl_wasm_dir)


def _apply_wasm_common_linkflags(env, env_mono):
    """Apply WASM link flags shared by both AOT and Interpreter modes."""
    wasm_threads = env.get("wasm_threads", False)
    if wasm_threads:
        env_mono.Append(CPPDEFINES=[("MONO_WASM_THREADS", 1)])
        env.Append(LINKFLAGS=[
            "-s", "PROXY_TO_PTHREAD=1",
            "-s", "PTHREAD_POOL_SIZE=4",
            "-s", "SHARED_MEMORY=1",
        ])
    else:
        env.Append(LINKFLAGS=[
            "-s", "PROXY_TO_PTHREAD=0",
            "-s", "PTHREAD_POOL_SIZE=0",
        ])

    wasm_memory = env.get("wasm_memory_size", 256)
    env.Append(LINKFLAGS=[
        "-s", "ALLOW_MEMORY_GROWTH=1",
        "-s", ("TOTAL_MEMORY=%dMB" % wasm_memory),
    ])

    # Mono WASM libraries reference JS-side functions; don't error on them.
    env.Append(LINKFLAGS=["-sERROR_ON_UNDEFINED_SYMBOLS=0"])
    # C++ exception support required by Mono runtime.
    env.Append(LINKFLAGS=["-sDISABLE_EXCEPTION_THROWING=0"])
    env.Append(LINKFLAGS=["-sDISABLE_EXCEPTION_CATCHING=0"])
    env.Append(LINKFLAGS=["-sSUPPORT_LONGJMP=emscripten"])

    return wasm_threads, wasm_memory


def _run_aot_workflow(env, env_mono, mono_sources_list):
    """Full AOT workflow: compile DLLs, AOT compile, generate registration code, link."""
    import os
    import sys
    import subprocess
    import shutil
    from pathlib import Path

    project_root = Dir("#").abspath

    # 1. Detect cross-compiler
    # WASM-specific cross-compiler (built with --target=wasm32-unknown-none)
    # Falls back to x86_64 cross-compiler for non-WASM platforms
    mono_aot_cross = os.environ.get("MONO_AOT_CROSS",
        "/opt/mono-aot-cross-wasm/bin/mono")
    if not os.path.exists(mono_aot_cross):
        # Try x86_64 fallback
        mono_aot_cross = os.environ.get("MONO_AOT_CROSS_X64",
            "/opt/mono-aot-cross/bin/mono-aot-cross")
    if not os.path.exists(mono_aot_cross):
        raise SCons.Errors.StopError(
            "mono-aot-cross not found. Build it from Mono 6.12 source with LLVM 10"
            " WASM backend (see docs/superpowers/specs/2026-07-14-mono-full-aot-workflow-design.md)."
            " Expected at /opt/mono-aot-cross-wasm/bin/mono-aot-cross or /opt/mono-aot-cross/bin/mono-aot-cross.")

    # 2. Determine DLL paths (BCL dir resolved via shared helper)
    bcl_dir = _get_bcl_wasm_dir()
    if not bcl_dir or not os.path.isdir(bcl_dir):
        # AOT-specific fallback: WSL path
        bcl_dir = "/e/workspace/godot/mono-wasm-output/bcl/lib/mono/4.5"

    godotsharp_dll = os.path.join(project_root, "build_godotsharp", "GodotSharp.dll")
    projectscripts_dll = os.path.join(project_root, "csharp_test", "ProjectScripts.dll")

    if not os.path.exists(godotsharp_dll):
        raise SCons.Errors.StopError(
            "GodotSharp.dll not found at %s" % godotsharp_dll)
    if not os.path.exists(projectscripts_dll):
        print("[Mono] AOT WARNING: ProjectScripts.dll not found, AOT will skip user assembly")

    # 3. Setup AOT cache directory
    aot_cache = os.path.join(project_root, "mono", "aot-cache")
    os.makedirs(aot_cache, exist_ok=True)

    # 4. Incremental build check
    # M5 fix: build asm_name -> dll_path map (BCL + user), pass to check_cache_stale.
    # Previously passed a flat dll_paths list (BCL excluded) and update_cache_hash
    # inferred DLL path from obj_path (always failed) → cache never hit.
    cache_hash_file = os.path.join(aot_cache, ".cache_hashes.json")
    dll_path_map = {}
    for bcl_dll in ["mscorlib.dll", "System.dll", "System.Core.dll"]:
        bcl_p = os.path.join(bcl_dir, bcl_dll)
        if os.path.exists(bcl_p):
            dll_path_map[bcl_dll.replace(".dll", "")] = bcl_p
    if os.path.exists(godotsharp_dll):
        dll_path_map["GodotSharp"] = godotsharp_dll
    if os.path.exists(projectscripts_dll):
        dll_path_map["ProjectScripts"] = projectscripts_dll

    need_rebuild = True
    try:
        sys.path.insert(0, os.path.join(project_root, "tools"))
        from aot_compile import check_cache_stale
        need_rebuild = check_cache_stale(cache_hash_file, dll_path_map)
    except Exception as e:
        print("[Mono] AOT: Cache check failed (%s), forcing rebuild" % str(e))

    if need_rebuild:
        print("[Mono] AOT: Starting Full AOT compilation workflow...")

        # 5. Call aot_compile.py
        cmd = [
            sys.executable,
            os.path.join(project_root, "tools", "aot_compile.py"),
            "--mono-aot-cross", mono_aot_cross,
            "--bcl-dir", bcl_dir,
            "--assemblies", "GodotSharp.dll" +
                (",ProjectScripts.dll" if os.path.exists(projectscripts_dll) else ""),
            "--assembly-dir", os.path.dirname(godotsharp_dll),
            "--output-dir", aot_cache,
            "--platform", "wasm",
            "--aot-opts", "full,static,direct-icalls,llvmonly,asmonly,no-opt,deterministic,trampolines=4096",
            "--extract-generics",
            "--source-dirs", os.path.join(project_root, "build_godotsharp") +
                "," + os.path.join(project_root, "csharp_test"),
            "--manual-roots", os.path.join(project_root, "build_godotsharp", "GenericRoots.manual.cs"),
            "--cache-hash-file", cache_hash_file,
        ]

        result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if result.returncode != 0:
            raise SCons.Errors.StopError(
                "AOT compilation failed:\n%s\n%s" % (result.stdout, result.stderr))
        print(result.stdout)
    else:
        print("[Mono] AOT: Cache up-to-date, skipping AOT compilation.")

    # 6. Replace mono_aot_modules.cpp with generated version
    gen_cpp = os.path.join(aot_cache, "mono_aot_modules.gen.cpp")
    if os.path.exists(gen_cpp):
        target_cpp = os.path.join(project_root, "modules", "mono",
                                   "mono_aot_modules.gen.cpp")
        shutil.copy2(gen_cpp, target_cpp)
        if "mono_aot_modules.cpp" in mono_sources_list:
            mono_sources_list.remove("mono_aot_modules.cpp")
        if "mono_aot_modules.gen.cpp" not in mono_sources_list:
            mono_sources_list.append("mono_aot_modules.gen.cpp")
        print("[Mono] AOT: Using generated module table: %s" % target_cpp)
    else:
        raise SCons.Errors.StopError(
            "AOT module table not generated: %s" % gen_cpp)

    # 7. Recompile ProjectScripts.dll with GenericRoots.gen.cs
    gen_roots_cs = os.path.join(aot_cache, "GenericRoots.gen.cs")
    if os.path.exists(gen_roots_cs):
        _recompile_projectscripts_with_roots(env, project_root, gen_roots_cs)


def _recompile_projectscripts_with_roots(env, project_root, gen_roots_cs):
    """Recompile ProjectScripts.dll with GenericRoots.gen.cs included."""
    import os
    import subprocess

    csc = r"C:\Windows\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
    if not os.path.exists(csc):
        csc = "csc"

    godotsharp_dll = os.path.join(project_root, "build_godotsharp", "GodotSharp.dll")
    netstandard = r"C:\Program Files\Mono\lib\mono\4.5\Facades\netstandard.dll"
    csharp_test_dir = os.path.join(project_root, "csharp_test")
    output_dll = os.path.join(project_root, "csharp_test", "ProjectScripts.dll")

    attr_cs = os.path.join(project_root, "build_godotsharp", "MonoAotGenericAttribute.cs")
    manual_cs = os.path.join(project_root, "build_godotsharp", "GenericRoots.manual.cs")

    cmd = [
        csc, "/target:library",
        "/out:" + output_dll,
        "/reference:" + godotsharp_dll,
        "/nologo",
    ]
    if os.path.exists(netstandard):
        cmd.append("/reference:" + netstandard)
    # Auto-include all .cs files in csharp_test (Test.cs, Game2048.cs, etc.)
    if os.path.isdir(csharp_test_dir):
        for fname in sorted(os.listdir(csharp_test_dir)):
            if fname.endswith(".cs"):
                cmd.append(os.path.join(csharp_test_dir, fname))
    if os.path.exists(attr_cs):
        cmd.append(attr_cs)
    if os.path.exists(manual_cs):
        cmd.append(manual_cs)
    cmd.append(gen_roots_cs)

    print("[Mono] AOT: Recompiling ProjectScripts.dll with GenericRoots...")
    result = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if result.returncode != 0:
        raise SCons.Errors.StopError(
            "ProjectScripts.dll recompilation failed:\n%s\n%s" % (result.stdout, result.stderr))
    print("[Mono] AOT: ProjectScripts.dll recompiled (%d bytes)" % os.path.getsize(output_dll))


if env["platform"] == "windows":
    env_mono.Append(CPPDEFINES=[
        ("MONO_JIT_MODE", 1),
        ("_CRT_SECURE_NO_WARNINGS", 1),
    ])

    import os
    mono_install_lib = "C:/Program Files/Mono/lib"
    local_mono_lib = mono_root + "/libs/windows/x64"
    
    if os.path.isdir(mono_install_lib):
        mono_lib_path = mono_install_lib
    else:
        mono_lib_path = local_mono_lib
    
    env.Prepend(LIBPATH=[mono_lib_path])
    env_mono.Prepend(LIBPATH=[mono_lib_path])

    if env.msvc:
        # Use the static Mono library to produce a DLL-less executable.
        # libmono-static-sgen.lib (~29MB) contains the full Mono SGen runtime;
        # mono-2.0-sgen.lib (~274KB) is only an import library for the DLL.
        #
        # The Mono static lib was compiled with /MD (dynamic CRT) and uses
        # __declspec(dllimport) for CRT functions, producing __imp_ prefixed
        # symbol references. mono_static_compat.c embeds /ALTERNATENAME
        # linker directives via #pragma comment(linker, ...) to redirect
        # these to statically-linked CRT functions.
        env.Append(LINKFLAGS=[
            "libmono-static-sgen.lib",
            "MonoPosixHelper.lib",
            "ws2_32.lib",
            "psapi.lib",
            "version.lib",
            "winmm.lib",
            "bcrypt.lib",
            "ole32.lib",
            "oldnames.lib",
        ])
        # Add the static-compat shim (provides __imp_ → CRT name redirects)
        mono_sources.append("mono_static_compat.c")
    else:
        env.Append(LIBS=[
            "mono-2.0-sgen",
            "MonoPosixHelper",
            "ws2_32",
            "psapi",
            "version",
            "winmm",
            "bcrypt",
            "ole32",
            "oldnames",
        ])

elif env["platform"] in ["x11", "linuxbsd"]:

#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

import os

env_wechat = env_modules.Clone()
env_wechat.Append(CPPDEFINES=[("WECHAT_MINIGAME_ENABLED", 1)])
env_wechat.Append(CPPPATH=["#platform/web"])

# Reuse the web platform's C++ sources. Only list files that actually exist
# under platform/web so the build does not reference missing sources.
web_platform_dir = Dir("#platform/web").abspath
web_sources = [
    "os_web.cpp",
    "display_server_web.cpp",
    "javascript_bridge_singleton.cpp",
    "audio_driver_web.cpp",
    "http_client_web.cpp",
    "web_main.cpp",
    "web_runtime.cpp",
    "api/api.cpp",
]

for src in web_sources:
    src_path = os.path.join(web_platform_dir, src)
    if os.path.exists(src_path):
        env_wechat.add_source_files(env.modules_sources, [src_path])

# Platform-specific API registration entry point.
env_wechat.add_source_files(env.modules_sources, ["api/api.cpp"])

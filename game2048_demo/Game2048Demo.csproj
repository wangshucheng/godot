<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Game2048Demo</AssemblyName>
    <RootNamespace>Game2048Demo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath>.mono/assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>..\bin\GodotSharp\Api\Debug\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Exclude Android build directory from C# compilation to avoid duplicate
       definitions when Godot's export process copies .cs files into
       android/build/src/main/assets/ -->
  <ItemGroup>
    <Compile Remove="android/**" />
  </ItemGroup>
</Project>
